# PostgreSQL Connection String (e.g., local PostgreSQL, Neon, AWS RDS, etc.)
DATABASE_URL="postgresql://username:password@localhost:5432/hyperlocal_db?schema=public"

# JSON Web Token Secret (used for signing authentication tokens)
JWT_SECRET="your_jwt_secret_key_here"

# Express server port (Optional, defaults to 5000 if not set)
PORT=5000
